# Telegram bot tokeni (BotFather beradi). Hech kimga ko'rsatmang!
BOT_TOKEN=
# Xabar oladigan Telegram ID(lar). Bir nechta bo'lsa vergul bilan: 6613741078,123456789
ADMIN_IDS=
# Saytning internetdagi https manzili (Mini App va "Saytni ochish" tugmasi uchun shart)
PUBLIC_URL=
# Kunlik xabar soati (Toshkent vaqti) va necha kun oldin eslatish
REMIND_HOUR=10
REMIND_DAYS=3
# Brauzerda kirish kaliti (o'zgartirsangiz, eski havolalar ishlamay qoladi)
ACCESS_KEY=
PORT=3000
